---
/**
 * Site-Footer für docs.fraghugo.de
 *
 * Wrappt den Starlight-Default-Footer (Pagination, LastUpdated, EditLink),
 * hängt darunter den brand-konformen Site-Footer mit Cross-Links nach
 * www.fraghugo.de — schliesst die Doku optisch ab und gibt Link-Juice
 * zurück an die Hauptseite.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();

// Dynamische Anleitungen-Zählung — alle docs-Einträge ausser der Startseite
const allDocs = await getCollection('docs');
const guideCount = allDocs.filter((entry) => entry.slug !== '' && entry.slug !== 'index').length;

const produkte = [
  { href: 'https://www.fraghugo.de/leistungen/', label: 'Alle Leistungen & Preise' },
  { href: 'https://www.fraghugo.de/datenschutz/', label: 'Datenschutz-Suite' },
  { href: 'https://www.fraghugo.de/website-check/', label: 'Website & IT-Sicherheit' },
  { href: 'https://www.fraghugo.de/lieferkette/', label: 'Lieferkette (Shield)' },
  { href: 'https://www.fraghugo.de/nis2/', label: 'NIS2 & ISMS' },
  { href: 'https://www.fraghugo.de/beratung/', label: 'Beratung & externer DSB' },
];

const unternehmen = [
  { href: 'https://www.fraghugo.de/ueber-uns/', label: 'Über uns' },
  { href: 'https://www.fraghugo.de/autoren/nils-oehmichen/', label: 'Nils Oehmichen' },
  { href: 'https://www.fraghugo.de/autoren/jens-hagel/', label: 'Jens Hagel' },
  { href: 'https://www.fraghugo.de/blog/', label: 'Blog' },
  { href: 'https://www.fraghugo.de/kontakt/', label: 'Kontakt' },
];

const apps = [
  { href: 'https://app.fraghugo.de', label: 'Plattform öffnen (Login)' },
  { href: 'https://app.fraghugo.de/signup', label: 'Konto kostenlos anlegen' },
  { href: 'https://check.fraghugo.de', label: 'Schnell-Check (ohne Login)' },
  { href: 'https://www.fraghugo.de/beratung/', label: 'Erstgespräch buchen' },
  { href: 'https://www.fraghugo.de/partner/', label: 'Partner-Programm (Systemhäuser)' },
];
---

<Default><slot /></Default>

<footer class="fh-site-footer" aria-label="Seitenfußzeile">
  <div class="fh-footer-glow" aria-hidden="true"></div>

  <div class="fh-footer-inner">
    <div class="fh-footer-grid">

      <!-- Brand -->
      <div class="fh-footer-brand">
        <a href="https://www.fraghugo.de" class="fh-brand-link" aria-label="Zur Hauptseite fraghugo.de">
          <img
            src="/logo.svg"
            alt="frag.hugo Informationssicherheit"
            width="160"
            height="44"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="fh-brand-claim">
          Datenschutz &amp; IT-Sicherheit für den deutschen Mittelstand.
          Software + persönliche Beratung aus Hamburg.
        </p>
        <a
          href="https://www.linkedin.com/company/frag-hugo-informationssicherheit-gmbh/"
          target="_blank"
          rel="noopener noreferrer"
          class="fh-social-link"
          aria-label="frag.hugo auf LinkedIn"
        >
          <svg class="fh-social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>

      <!-- Produkte -->
      <nav class="fh-footer-col" aria-label="Produkte">
        <p class="fh-col-heading">Produkte</p>
        <ul>
          {produkte.map((link) => (
            <li>
              <a href={link.href} class="fh-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Unternehmen -->
      <nav class="fh-footer-col" aria-label="Unternehmen">
        <p class="fh-col-heading">Unternehmen</p>
        <ul>
          {unternehmen.map((link) => (
            <li>
              <a href={link.href} class="fh-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Apps -->
      <nav class="fh-footer-col" aria-label="Apps direkt öffnen">
        <p class="fh-col-heading">Direkt starten</p>
        <ul>
          {apps.map((link) => (
            <li>
              <a href={link.href} class="fh-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="fh-footer-bottom">
      <p class="fh-copyright">
        &copy; {currentYear} frag.hugo Informationssicherheit GmbH · <span class="fh-guide-count">{guideCount} Anleitungen</span>
      </p>
      <p class="fh-de-badge" aria-label="Datenverarbeitung in Deutschland">
        <svg class="fh-flag" viewBox="0 0 20 15" aria-hidden="true">
          <rect width="20" height="5" rx="1" fill="#181818"/>
          <rect y="5" width="20" height="5" fill="#DD0000"/>
          <rect y="10" width="20" height="5" rx="1" fill="#FFCC00"/>
        </svg>
        100 % Datenverarbeitung in Deutschland
      </p>
      <ul class="fh-legal-links">
        <li><a href="https://www.fraghugo.de" class="fh-legal-link">Hauptseite</a></li>
        <li><a href="https://www.fraghugo.de/impressum/" class="fh-legal-link">Impressum</a></li>
        <li><a href="https://www.fraghugo.de/datenschutzerklaerung/" class="fh-legal-link">Datenschutz</a></li>
        <li><a href="https://www.fraghugo.de/subprozessoren/" class="fh-legal-link">Subprozessoren</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .fh-site-footer {
    position: relative;
    overflow: hidden;
    margin-top: 4rem;
    padding-top: 1px;
    background: var(--bg-section, #0F1629);
    color: var(--text-secondary, #CBD5E1);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  /* Top glow divider — dezent, refined */
  .fh-footer-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(14, 165, 233, 0.4) 30%,
      rgba(14, 165, 233, 0.6) 50%,
      rgba(14, 165, 233, 0.4) 70%,
      transparent 100%
    );
  }

  .fh-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 2rem;
  }

  /* ─── Grid ─── */
  .fh-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 40rem) {
    .fh-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }
  }

  @media (min-width: 64rem) {
    .fh-footer-grid {
      grid-template-columns: 2.4fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  /* ─── Brand-Spalte ─── */
  .fh-brand-link {
    display: inline-block;
    margin-bottom: 1.25rem;
    transition: transform 0.3s var(--ease-out, ease);
  }

  .fh-brand-link:hover {
    transform: scale(1.02);
  }

  .fh-brand-link img {
    width: 160px;
    height: auto;
  }

  .fh-brand-claim {
    color: var(--text-muted, #94A3B8);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    max-width: 22rem;
  }

  .fh-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted, #94A3B8);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .fh-social-link:hover {
    color: var(--hugo-teal, #0EA5E9);
  }

  .fh-social-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* ─── Link-Spalten ─── */
  .fh-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .fh-col-heading {
    position: relative;
    color: var(--text-primary, #FFFFFF);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
  }

  .fh-col-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--hugo-teal, #0EA5E9), transparent);
  }

  .fh-footer-link {
    display: inline-block;
    color: var(--text-muted, #94A3B8);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .fh-footer-link:hover {
    color: var(--text-primary, #FFFFFF);
    transform: translateX(3px);
  }

  /* ─── Bottom Bar ─── */
  .fh-footer-bottom {
    border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.06));
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .fh-footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .fh-copyright {
    color: var(--text-faint, #64748B);
    font-size: 0.75rem;
    margin: 0;
  }

  .fh-de-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-faint, #64748B);
    font-size: 0.75rem;
    margin: 0;
  }

  .fh-flag {
    width: 1rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  .fh-legal-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .fh-legal-link {
    color: var(--text-faint, #64748B);
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .fh-legal-link:hover {
    color: var(--hugo-teal, #0EA5E9);
  }

  /* ─── Reduced Motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .fh-brand-link,
    .fh-footer-link,
    .fh-social-link,
    .fh-legal-link {
      transition: none;
    }

    .fh-brand-link:hover,
    .fh-footer-link:hover {
      transform: none;
    }
  }
</style>
